# 이 파일은 샘플입니다 (GitHub에 올라감). 실제 값은 .env 파일에 따로 넣으세요.
# Supabase 대시보드 > Project Settings > API 에서 확인 가능

VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 에서 발급 (Cloud Translation API 활성화 필요)
# 주의: 이 키는 브라우저 코드에서 직접 호출하는 임시 방식이라, 실제 출시 전 서버 함수로 옮겨야 함 (README 참고)
VITE_GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key-here
